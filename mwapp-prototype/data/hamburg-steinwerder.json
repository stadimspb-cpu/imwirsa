    "hamburg_steinwerder_centre_location": {
      "title": "Location & Route",
      "callout": {
        "tone": "ok",
        "text": "Walkable — about 30 minutes to the Alter Elbtunnel, then 5 more minutes through the tunnel to St. Pauli/Landungsbrücken."
      },
      "sections": [
        {
          "icon": "🚶",
          "title": "Route",
          "rows": [
            {
              "icon": "🚶",
              "title": "Follow the signs from the terminal towards \"Elbtunnel\"",
              "sub": "The path runs along a well-lit riverside promenade"
            },
            {
              "icon": "🚇",
              "title": "Alter Elbtunnel (1911)",
              "sub": "Open 24/7 for pedestrians and cyclists, free"
            }
          ]
        },
        {
          "icon": "🚫",
          "title": "Avoid",
          "rows": [
            {
              "icon": "🚫",
              "title": "Don't wander into industrial port areas outside the marked pedestrian route",
              "sub": ""
            }
          ]
        }
      ],
      "updated": "12 August 2026"
    },
