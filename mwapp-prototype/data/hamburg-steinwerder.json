    "hamburg_steinwerder_centre_about": {
      "title": "About the Centre",
      "callout": {
        "tone": "info",
        "text": "There's no fixed clubhouse at Steinwerder — the Seafarer's Lounge is organised by Deutsche Seemannsmission Hamburg-Altona during cruise ship calls, typically 08:00–18:00/20:00."
      },
      "contacts": [
        {
          "icon": "✉️",
          "title": "lounge@seemannsmission-altona.de",
          "sub": "Email",
          "action": "✉️"
        },
        {
          "icon": "🌐",
          "title": "seemannsmission-altona.org",
          "sub": "Website",
          "action": "›"
        }
      ],
      "note": "Run by Deutsche Seemannsmission Hamburg-Altona e.V. Opening hours follow the ship-call schedule, not a fixed weekly timetable.",
      "updated": "12 August 2026"
    },
